export AICODER_BASE_IMAGE="images:debian/trixie/cloud"
export AICODER_BRIDGE="aicoderbr0"
export AICODER_BUILDER_NAME="aicoder-builder"
export AICODER_CPUS="4"
export AICODER_DISK="40GiB"
export AICODER_HOSTS_FILE="/etc/hosts"
export AICODER_IMAGE="aicoder-debian-trixie"
export AICODER_IMAGE_ALIAS="aicoder-debian-trixie"
export AICODER_INSTALL_OPENCODE="1"
export AICODER_MEMORY="8GiB"
export AICODER_NAME_PREFIX="aicoder"
export AICODER_PACKAGES="curl ca-certificates wget git vim jq htop tmux screen ripgrep fd-find unzip zip openssh-server sudo build-essential python3 python3-pip python3-venv nodejs npm"
export AICODER_POOL="default"
export AICODER_PROFILE="aicoder"
export AICODER_PROJECT="aicoder"
export AICODER_SSH_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"
export AICODER_SSH_USER="coder"
export AICODER_STATIC_RANDOM_IP="1"
export AICODER_UPDATE_HOSTS="1"
